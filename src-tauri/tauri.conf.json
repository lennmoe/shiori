{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiori RPC",
  "version": "2.2.1",
  "identifier": "moe.lenn.shiori",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shiori RPC",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "center": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://*.vndb.org https: data:; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "French", "Spanish", "PortugueseBR", "Japanese", "Russian", "Vietnamese"],
        "displayLanguageSelector": true
      }
    }
  }
}
